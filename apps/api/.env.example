# Пулерное подключение Neon: им пользуется приложение
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Прямое подключение Neon: только для миграций
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Минимум 32 байта, например: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Минимум 32 байта. Из него получается соль сборки клиента для подписи входа и регистрации
SALT_SECRET=

# Публичный origin фронта без слэша на конце
APP_URL=http://localhost:5173

# OAuth App на GitHub. Для локальной разработки нужно отдельное приложение
# с callback http://localhost:5173/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth-клиент Google типа Web application. Redirect URI:
# http://localhost:5173/api/v1/auth/google/callback и https://<web>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NODE_ENV=development
PORT=3000
# Sentry: DSN отдельного проекта Node.js. Без DSN мониторинг отключён.
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=
# На Vercel используется VERCEL_GIT_COMMIT_SHA, иначе задайте commit SHA вручную.
SENTRY_RELEASE=
