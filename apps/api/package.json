{
  "name": "@gwmt/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "cd ../.. && npm run build:shared",
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "docs": "tsx src/docs.ts",
    "openapi": "tsx src/docs.ts --export",
    "salt": "tsx src/salt-headers.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@gwmt/contracts": "*",
    "@gwmt/monitoring": "*",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/node": "^11.12.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
