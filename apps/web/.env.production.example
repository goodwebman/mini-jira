# Скопировать в .env.production.local для локальной проверки.
# В CI/Vercel задавать env через настройки окружения, не коммитить .local.
# mode=production: npm run build или npm run build:analyze из корня.
VITE_API_URL=/api/v1
VITE_APP_VERSION=1.0.0
# ОБЯЗАТЕЛЬНО: SHA256(SALT_SECRET + VITE_APP_VERSION), 64 hex-символа.
# SALT_SECRET остаётся на сервере; публичный хеш привязан к той же среде API.
VITE_AUTH_SALT=
# Необязательно: публичный DSN; без него приложение работает без мониторинга.
VITE_SENTRY_DSN=
# Пусто: VERCEL_ENV (production/preview), иначе production.
VITE_SENTRY_ENVIRONMENT=
# По умолчанию upload включён при наличии credentials. Для локальной проверки:
BUILD_SENTRY_UPLOAD=false
# В CI уберите false; SENTRY_AUTH_TOKEN/ORG/PROJECT задайте как build secrets.
# Нельзя добавлять префикс VITE_ к SENTRY_AUTH_TOKEN.
