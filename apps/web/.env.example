# Базовый адрес API. Локально запросы идут через Vite proxy.
VITE_API_URL=/api/v1

# Подпись входа и регистрации, см. README в корне: «Подпись входа и регистрации».
# Версия сборки, по ней сервер восстанавливает соль
VITE_APP_VERSION=1.0.0

# SHA256(SALT_SECRET + VITE_APP_VERSION). Это не секрет: значение попадает в бандл.
# node -e "console.log(require('crypto').createHash('sha256').update(process.argv[1]+process.argv[2]).digest('hex'))" "$SALT_SECRET" 1.0.0
VITE_AUTH_SALT=

# Sentry: публичный DSN проекта React. Без DSN мониторинг отключён.
VITE_SENTRY_DSN=
# Локальная проверка: true. В production включается автоматически при наличии DSN.
VITE_SENTRY_ENABLED=false
# Не задавайте локально, если хотите environment=development.
VITE_SENTRY_ENVIRONMENT=

# Только build/CI secrets, БЕЗ префикса VITE_. Нужны для загрузки source maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Для Vercel используется commit SHA автоматически; иначе задайте уникальный release.
SENTRY_RELEASE=
