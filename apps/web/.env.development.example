# Скопировать в .env.development.local. Файл .example сам Vite не загружает.
# Общие VITE_APP_VERSION/VITE_AUTH_SALT и Sentry описаны в .env.example.
# mode=development: npm run dev:web или npm run build:dev из корня.
VITE_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:3000
VITE_SENTRY_ENABLED=false
# Пусто: environment автоматически станет development.
VITE_SENTRY_ENVIRONMENT=
