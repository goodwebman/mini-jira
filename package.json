{
  "name": "gwmt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 114",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "prepare": "husky",
    "dev": "npm run build:contracts && concurrently --kill-others --names api,web \"npm run dev -w @gwmt/api\" \"npm run dev:web\"",
    "build:contracts": "npm run build -w @gwmt/contracts",
    "build": "npm run build:contracts && npm run build -w mini-jira",
    "dev:contracts": "npm run dev -w @gwmt/contracts",
    "dev:api": "npm run build:contracts && npm run dev -w @gwmt/api",
    "dev:web": "npm run dev -w mini-jira",
    "docs": "npm run build:contracts && npm run docs -w @gwmt/api",
    "openapi": "npm run build:contracts && npm run openapi -w @gwmt/api",
    "salt": "npm run salt -w @gwmt/api --",
    "db:generate": "npm run db:generate -w @gwmt/api",
    "db:migrate": "npm run db:migrate -w @gwmt/api",
    "db:seed": "npm run build:contracts && npm run db:seed -w @gwmt/api",
    "typecheck": "npm run build:contracts && npm run typecheck -w @gwmt/contracts -w @gwmt/api -w mini-jira",
    "test:lint": "node --test scripts/eslint-config.test.mjs",
    "test": "npm run test:lint && npm run build:contracts && npm run test -w @gwmt/contracts -w @gwmt/api -w mini-jira",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "browserslist-to-esbuild": "^2.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "typescript-eslint": "^8.72.1"
  }
}
