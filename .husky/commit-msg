#!/usr/bin/env sh
set -eu

# Run checks here: pre-commit runs before Git makes the message available.
status=0

printf '\n%s\n' 'Проверка сообщения коммита (commitlint)...'
if node node_modules/@commitlint/cli/cli.js --edit "$1" --verbose; then
  printf '%s\n' 'Сообщение коммита: OK.'
else
  status=1
  printf '%s\n' \
    'ОШИБКА: сообщение коммита не прошло проверку. Причины указаны выше.' \
    'Формат: type(scope): описание или type: описание.' \
    'Типы: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.' \
    'Описание: непустое, до 72 символов. Пример: fix: исправить проверку коммита'
fi

printf '\n%s\n' 'Проверка подготовленных файлов (ESLint / Prettier)...'
if node node_modules/lint-staged/bin/lint-staged.js --concurrent false --continue-on-error --verbose --max-arg-length 7000; then
  printf '%s\n' 'Подготовленные файлы: OK.'
else
  status=1
  printf '%s\n' \
    'ОШИБКА: проверка файлов не пройдена. Выше указаны файлы, строки и правила либо ошибки запуска инструментов.' \
    'ESLint блокирует коммит при ошибках и предупреждениях (--max-warnings 0).' \
    'Проверить вручную: npm run lint и npm run format:check.'
fi

printf '\n%s\n' 'Проверка всего рабочего дерева (ESLint), включая файлы вне git add...'
if node node_modules/eslint/bin/eslint.js . --max-warnings 0; then
  printf '%s\n' 'ESLint рабочего дерева: OK.'
else
  status=1
  printf '%s\n' 'ОШИБКА ESLint: исправьте нарушения в указанных выше файлах и строках.'
fi

printf '\n%s\n' 'Проверка TypeScript (contracts / api / web), включая файлы вне git add...'
if npm run typecheck; then
  printf '%s\n' 'TypeScript: OK.'
else
  status=1
  printf '%s\n' 'ОШИБКА TypeScript: исправьте ошибки типов и неизвестные имена в указанных выше файлах и строках.'
fi

if [ "$status" -ne 0 ]; then
  printf '\n%s\n' 'Коммит НЕ создан. Исправьте указанные выше ошибки и повторите git commit.'
fi

exit "$status"
